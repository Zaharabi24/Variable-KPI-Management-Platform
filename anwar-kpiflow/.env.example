# Postgres. Neon via the Vercel Marketplace provides both automatically.
# POSTGRES_PRISMA_URL = pooled connection (must include pgbouncer=true); POSTGRES_URL_NON_POOLING = direct connection for schema pushes.
POSTGRES_PRISMA_URL="postgresql://user:password@host-pooler/db?sslmode=require&pgbouncer=true&connect_timeout=15"
POSTGRES_URL_NON_POOLING="postgresql://user:password@host/db?sslmode=require"
SESSION_SECRET="change-me-to-a-long-random-string"
APP_URL="http://localhost:3000"
