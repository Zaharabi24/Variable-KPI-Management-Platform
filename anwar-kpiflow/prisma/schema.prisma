generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // pooled, with pgbouncer=true (Neon via Vercel Marketplace)
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model BusinessUnit {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now())
  users     User[]
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now())
  users     User[]
}

model User {
  id             String        @id @default(cuid())
  fullName       String
  email          String        @unique
  employeeId     String        @unique
  role           String // SUPER_ADMIN | SYSTEM_ADMIN | DEPARTMENT_HEAD | HR_ADMIN | FINANCE_ADMIN | AUDIT_ADMIN | EMPLOYEE
  designation    String?
  corporatePhone String?
  passwordHash   String?
  status         String        @default("PENDING_SETUP") // PENDING_SETUP | ACTIVE | DEACTIVATED
  failedLogins   Int           @default(0)
  lockedUntil    DateTime?
  businessUnitId String?
  departmentId   String?
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id])
  department     Department?   @relation(fields: [departmentId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  ownedKpis       Kpi[]            @relation("KpiOwner")
  approvingKpis   Kpi[]            @relation("KpiApprover")
  tokens          AccountToken[]   @relation("TokenUser")
  sentInvitations AccountToken[]   @relation("TokenInviter")
  versions        KpiVersion[]
  decisions       ReviewDecision[]
  auditLogs       AuditLog[]
  evidenceFiles   EvidenceFile[]

  // KPI approval chain: the decisions this user recorded at each stage
  kpiDeptDecisions    Kpi[] @relation("KpiDeptDecidedBy")
  kpiHrDecisions      Kpi[] @relation("KpiHrDecidedBy")
  kpiFinanceDecisions Kpi[] @relation("KpiFinanceDecidedBy")
  kpiAuditDecisions   Kpi[] @relation("KpiAuditDecidedBy")

  // Columns of the removed Variable Pay module. Nothing reads or writes them any more;
  // they stay in the table so that removing the module does not drop any stored data.
  dateOfJoining       DateTime?
  variablePayEligible Boolean   @default(false)
  supervisorName      String?

  // Mailbox
  sentMail     MailMessage[]   @relation("MailSender")
  receivedMail MailRecipient[] @relation("MailRecipientUser")
}

model AccountToken {
  id          String    @id @default(cuid())
  token       String    @unique
  type        String // SIGNUP | INVITATION | RESET
  userId      String
  user        User      @relation("TokenUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedById String?
  invitedBy   User?     @relation("TokenInviter", fields: [invitedById], references: [id])
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
}

/// A KPI is one employee's monthly score sheet (the "KPI Score Break Down" plus the score strip).
/// Approval chain: Employee -> Department Head -> HR Admin -> Finance Admin -> Audit Admin.
/// Who fills what, the maxima and the status machine live in lib/kpi.ts.
model Kpi {
  id          String @id @default(cuid())
  periodYear  Int
  periodMonth Int
  status      String // see KPI_STATUS in lib/kpi.ts

  // Employee
  remarks   String @default("") @db.Text
  selfScore Float? // sum of the five task scores as the employee submitted them (out of 50)

  // Department Head (KPI (5) is the sum of the task scores after their review)
  kpiScore               Float? // 50
  qualityOfWork          Float? // 15
  timelineOfDeliverables Float? // 20
  stakeholderPeerReview  Float? // 5
  adjusted               Boolean @default(false) // the Department Head changed the employee's breakdown
  adjustReason           String? @db.Text

  // HR Admin
  attendance    Float? // 10
  hrRemarks     String? @db.Text
  hrNote        String? @db.Text
  paymentAmount Float? // never shown to the employee or the Department Head
  totalScore    Float? // 100, set when HR approves

  // Finance Admin / Audit Admin
  financeNote String? @db.Text
  auditNote   String? @db.Text

  ownerId    String
  owner      User    @relation("KpiOwner", fields: [ownerId], references: [id])
  approverId String?
  approver   User?   @relation("KpiApprover", fields: [approverId], references: [id])

  currentVersion Int      @default(0)
  returnRemarks  String?  @db.Text // why it was last sent back, at whichever stage
  decisionReason String?  @db.Text // rejection reason
  submittedAt    DateTime @default(now())

  deptDecidedAt      DateTime?
  deptDecidedById    String?
  deptDecidedBy      User?     @relation("KpiDeptDecidedBy", fields: [deptDecidedById], references: [id])
  hrDecidedAt        DateTime?
  hrDecidedById      String?
  hrDecidedBy        User?     @relation("KpiHrDecidedBy", fields: [hrDecidedById], references: [id])
  financeDecidedAt   DateTime?
  financeDecidedById String?
  financeDecidedBy   User?     @relation("KpiFinanceDecidedBy", fields: [financeDecidedById], references: [id])
  auditDecidedAt     DateTime?
  auditDecidedById   String?
  auditDecidedBy     User?     @relation("KpiAuditDecidedBy", fields: [auditDecidedById], references: [id])

  deletedAt    DateTime?
  deleteReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tasks     KpiTask[]
  evidence  EvidenceFile[]
  versions  KpiVersion[]
  decisions ReviewDecision[]

  @@index([ownerId, periodYear, periodMonth])
  @@index([status])
}

/// "KPI Score Break Down": 5 Major Tasks, each scored out of 10.
model KpiTask {
  id            String @id @default(cuid())
  kpiId         String
  kpi           Kpi    @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  sl            Int // 1..5
  task          String @default("")
  employeeScore Float? // as the employee submitted it
  score         Float? // current score (the Department Head may adjust it)
  remarks       String @default("")

  @@unique([kpiId, sl])
}

model EvidenceFile {
  id           String   @id @default(cuid())
  kpiId        String
  kpi          Kpi      @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  fileName     String
  storedName   String
  mimeType     String
  size         Int
  sha256       String
  data         Bytes // file content lives in the database so deployments with ephemeral disks (Vercel) keep evidence
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

model KpiVersion {
  id          String   @id @default(cuid())
  kpiId       String
  kpi         Kpi      @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  versionNo   Int
  action      String // SUBMIT | RESUBMIT | DEPT_APPROVE | DEPT_ADJUST | DEPT_RETURN | DEPT_REJECT | HR_APPROVE | HR_RETURN | FINANCE_APPROVE | FINANCE_RETURN | AUDIT_APPROVE | AUDIT_RETURN | DELETE
  snapshot    String   @db.Text // JSON of the KPI record after the action
  changes     String   @db.Text // JSON array of { field, oldValue, newValue }
  reason      String?
  changedById String
  changedBy   User     @relation(fields: [changedById], references: [id])
  createdAt   DateTime @default(now())

  @@unique([kpiId, versionNo])
}

model ReviewDecision {
  id         String   @id @default(cuid())
  kpiId      String
  kpi        Kpi      @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User     @relation(fields: [reviewerId], references: [id])
  stage      String   @default("DEPT") // EMPLOYEE | DEPT | HR | FINANCE | AUDIT
  decision   String // same vocabulary as KpiVersion.action
  reason     String?
  createdAt  DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  details    String   @default("{}")
  createdAt  DateTime @default(now())
}

model EmailLog {
  id        String   @id @default(cuid())
  toEmail   String
  subject   String
  body      String   @db.Text
  link      String?
  createdAt DateTime @default(now())
}

/// Mailbox: a message written in the app by a Super Admin or Department Head.
/// A draft keeps its intended recipients as a JSON id list; sending freezes them into MailRecipient rows.
model MailMessage {
  id                String           @id @default(cuid())
  senderId          String
  sender            User             @relation("MailSender", fields: [senderId], references: [id], onDelete: Cascade)
  subject           String
  bodyHtml          String           @db.Text // sanitised on save (lib/mailbox.ts)
  status            String           @default("DRAFT") // DRAFT | SENT
  audience          String           @default("SELECTED") // SELECTED | ALL
  draftRecipientIds String           @default("[]") @db.Text
  recipientCount    Int              @default(0)
  sentAt            DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  recipients        MailRecipient[]
  attachments       MailAttachment[]

  @@index([senderId, status])
}

/// One delivered copy of a sent message. Name and email are snapshotted at send time.
model MailRecipient {
  id        String      @id @default(cuid())
  messageId String
  message   MailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation("MailRecipientUser", fields: [userId], references: [id], onDelete: Cascade)
  name      String
  email     String
  readAt    DateTime?

  @@unique([messageId, userId])
  @@index([userId, readAt])
}

model MailAttachment {
  id        String      @id @default(cuid())
  messageId String
  message   MailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileName  String
  mimeType  String
  size      Int
  sha256    String
  data      Bytes // kept in the database, like evidence files
  createdAt DateTime    @default(now())
}

model Setting {
  key   String @id
  value String
}
