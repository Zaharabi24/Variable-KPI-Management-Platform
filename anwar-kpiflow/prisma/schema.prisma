generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // pooled, with pgbouncer=true (Neon via Vercel Marketplace)
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model BusinessUnit {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now())
  users     User[]
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now())
  users     User[]
}

model User {
  id             String        @id @default(cuid())
  fullName       String
  email          String        @unique
  employeeId     String        @unique
  role           String // SUPER_ADMIN | DEPARTMENT_HEAD | EMPLOYEE
  designation    String?
  corporatePhone String?
  passwordHash   String?
  status         String        @default("PENDING_SETUP") // PENDING_SETUP | ACTIVE | DEACTIVATED
  failedLogins   Int           @default(0)
  lockedUntil    DateTime?
  businessUnitId String?
  departmentId   String?
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id])
  department     Department?   @relation(fields: [departmentId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  ownedKpis       Kpi[]            @relation("KpiOwner")
  approvingKpis   Kpi[]            @relation("KpiApprover")
  tokens          AccountToken[]   @relation("TokenUser")
  sentInvitations AccountToken[]   @relation("TokenInviter")
  versions        KpiVersion[]
  decisions       ReviewDecision[]
  auditLogs       AuditLog[]
  evidenceFiles   EvidenceFile[]

  // Variable Pay
  dateOfJoining       DateTime? // DOJ
  variablePayEligible Boolean   @default(false)
  supervisorName      String?
  vpEvaluations       VariablePayEvaluation[] @relation("VpEmployee")
  vpEvaluated         VariablePayEvaluation[] @relation("VpEvaluator")
  vpHrNotes           VariablePayEvaluation[] @relation("VpHrNoteBy")
  vpDecided           VariablePayEvaluation[] @relation("VpDecidedBy")
  vpPaymentsConfirmed VariablePayEvaluation[] @relation("VpPaymentBy")
  vpEvents            VariablePayEvent[]

  // Mailbox
  sentMail     MailMessage[]   @relation("MailSender")
  receivedMail MailRecipient[] @relation("MailRecipientUser")
}

model AccountToken {
  id          String    @id @default(cuid())
  token       String    @unique
  type        String // SIGNUP | INVITATION | RESET
  userId      String
  user        User      @relation("TokenUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedById String?
  invitedBy   User?     @relation("TokenInviter", fields: [invitedById], references: [id])
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
}

model Kpi {
  id              String    @id @default(cuid())
  name            String
  category        String // PROJECT | PEOPLE_CULTURE
  kpiType         String    @default("VARIABLE")
  periodYear      Int
  periodMonth     Int
  target          Float
  actual          Float
  unit            String    @default("")
  weight          Float
  achievement     Float
  calculatedScore Float
  finalScore      Float?
  status          String // DRAFT | SUBMITTED | RETURNED | APPROVED | ADJUSTED | REJECTED
  remarks         String
  dataSource      String    @default("verified_manual")
  ownerId         String
  owner           User      @relation("KpiOwner", fields: [ownerId], references: [id])
  approverId      String?
  approver        User?     @relation("KpiApprover", fields: [approverId], references: [id])
  currentVersion  Int       @default(1)
  returnRemarks   String?
  decisionReason  String?
  decidedAt       DateTime?
  submittedAt     DateTime  @default(now())
  deletedAt       DateTime?
  deleteReason    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  evidence  EvidenceFile[]
  versions  KpiVersion[]
  decisions ReviewDecision[]
}

model EvidenceFile {
  id           String   @id @default(cuid())
  kpiId        String
  kpi          Kpi      @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  fileName     String
  storedName   String
  mimeType     String
  size         Int
  sha256       String
  data         Bytes // file content lives in the database so deployments with ephemeral disks (Vercel) keep evidence
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

model KpiVersion {
  id          String   @id @default(cuid())
  kpiId       String
  kpi         Kpi      @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  versionNo   Int
  action      String // DRAFT | SUBMIT | RESUBMIT | APPROVE | ADJUST | RETURN | REJECT | EDIT | DELETE | TARGET_CHANGE
  snapshot    String @db.Text // JSON of the KPI record after the action
  changes     String @db.Text // JSON array of { field, oldValue, newValue }
  reason      String?
  changedById String
  changedBy   User     @relation(fields: [changedById], references: [id])
  createdAt   DateTime @default(now())

  @@unique([kpiId, versionNo])
}

model ReviewDecision {
  id         String   @id @default(cuid())
  kpiId      String
  kpi        Kpi      @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User     @relation(fields: [reviewerId], references: [id])
  decision   String // APPROVE | ADJUST | RETURN | REJECT | EDIT | DELETE
  reason     String?
  createdAt  DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  details    String   @default("{}")
  createdAt  DateTime @default(now())
}

model EmailLog {
  id        String   @id @default(cuid())
  toEmail   String
  subject   String
  body      String   @db.Text
  link      String?
  createdAt DateTime @default(now())
}

/// Mailbox: a message written in the app by a Super Admin or Department Head.
/// A draft keeps its intended recipients as a JSON id list; sending freezes them into MailRecipient rows.
model MailMessage {
  id                String           @id @default(cuid())
  senderId          String
  sender            User             @relation("MailSender", fields: [senderId], references: [id], onDelete: Cascade)
  subject           String
  bodyHtml          String           @db.Text // sanitised on save (lib/mailbox.ts)
  status            String           @default("DRAFT") // DRAFT | SENT
  audience          String           @default("SELECTED") // SELECTED | ALL
  draftRecipientIds String           @default("[]") @db.Text
  recipientCount    Int              @default(0)
  sentAt            DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  recipients        MailRecipient[]
  attachments       MailAttachment[]

  @@index([senderId, status])
}

/// One delivered copy of a sent message. Name and email are snapshotted at send time.
model MailRecipient {
  id        String      @id @default(cuid())
  messageId String
  message   MailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation("MailRecipientUser", fields: [userId], references: [id], onDelete: Cascade)
  name      String
  email     String
  readAt    DateTime?

  @@unique([messageId, userId])
  @@index([userId, readAt])
}

model MailAttachment {
  id        String      @id @default(cuid())
  messageId String
  message   MailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileName  String
  mimeType  String
  size      Int
  sha256    String
  data      Bytes // kept in the database, like evidence files
  createdAt DateTime    @default(now())
}

model Setting {
  key   String @id
  value String
}

/// Monthly Variable Pay evaluation of one eligible employee by their Department Head.
/// Employee details are snapshotted on every save so a submitted record stays reproducible.
model VariablePayEvaluation {
  id          String @id @default(cuid())
  employeeId  String
  employee    User   @relation("VpEmployee", fields: [employeeId], references: [id])
  evaluatorId String
  evaluator   User   @relation("VpEvaluator", fields: [evaluatorId], references: [id])
  periodYear  Int
  periodMonth Int
  status      String @default("DRAFT") // DRAFT | SUBMITTED | RETURNED | APPROVED | REJECTED | PAYMENT_CONFIRMED

  // Snapshot of the "Individual" columns
  empCode        String // ID
  empName        String // Name
  doj            DateTime? // DOJ
  days           Int? // Days
  tenure         String? // Tenure
  designation    String? // Designation
  departmentName String? // Department
  departmentId   String?
  supervisor     String? // Supervisor

  // Scores (maxima in lib/variable-pay.ts): KPI (5) 50, Quality of work 15, Time Line of Deliverables 20, Stakeholder & Peer Review 5, Attendance 10
  kpiScore               Float?
  qualityOfWork          Float?
  timelineOfDeliverables Float?
  stakeholderPeerReview  Float?
  attendance             Float?
  totalScore             Float?

  remarks      String?   @db.Text // Remarks
  hrNote       String?   @db.Text // HR Note
  hrNoteById   String?
  hrNoteBy     User?     @relation("VpHrNoteBy", fields: [hrNoteById], references: [id])
  hrNoteAt     DateTime?
  returnReason String?   @db.Text
  submittedAt  DateTime? // exact time of the latest submission

  // Super Admin decision (approve / return / reject)
  decidedById     String?
  decidedBy       User?     @relation("VpDecidedBy", fields: [decidedById], references: [id])
  decidedAt       DateTime?
  decisionComment String?   @db.Text

  // Finance: confirmed payment
  paymentAmount        Float?
  paymentReference     String?
  paymentNote          String?   @db.Text
  paymentConfirmedById String?
  paymentConfirmedBy   User?     @relation("VpPaymentBy", fields: [paymentConfirmedById], references: [id])
  paymentConfirmedAt   DateTime?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tasks  VariablePayTask[]
  events VariablePayEvent[]

  @@unique([employeeId, periodYear, periodMonth])
  @@index([periodYear, periodMonth, departmentId])
  @@index([status, submittedAt])
}

/// "KPI Score Break Down": 5 Major Tasks, each scored out of 10.
model VariablePayTask {
  id           String                @id @default(cuid())
  evaluationId String
  evaluation   VariablePayEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  sl           Int // SL.
  task         String                @db.Text // 5 Major Tasks
  score        Float? // Score (Out of 10 for Each)
  remarks      String?               @db.Text // Remarks

  @@unique([evaluationId, sl])
}

/// Append-only workflow history of a Variable Pay request: who did what, when, with which comment.
model VariablePayEvent {
  id           String                @id @default(cuid())
  evaluationId String
  evaluation   VariablePayEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  action       String // SUBMITTED | RESUBMITTED | APPROVED | RETURNED | REJECTED | HR_NOTE | PAYMENT_CONFIRMED
  actorId      String
  actor        User                  @relation(fields: [actorId], references: [id])
  comment      String?               @db.Text
  createdAt    DateTime              @default(now())

  @@index([evaluationId, createdAt])
}
